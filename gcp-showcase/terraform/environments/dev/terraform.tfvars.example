region = "us-central1"
zone   = "us-central1-a"

node_machine_type = "e2-medium"
node_count        = 2
node_min_count    = 1
node_max_count    = 3

db_tier              = "db-f1-micro"
db_availability_type = "ZONAL"
deletion_protection  = false

# project_id and db_password are NOT set here on purpose — CI injects them via
# TF_VAR_project_id / TF_VAR_db_password. A committed -var-file would otherwise
# override those env vars. For local runs, export TF_VAR_project_id and
# TF_VAR_db_password (or add them to your own uncommitted terraform.tfvars).
